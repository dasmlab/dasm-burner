# Stage 1: UI
FROM docker.io/library/node:22-bookworm AS web-builder
WORKDIR /app/web
COPY web/package.json web/package-lock.json* ./
RUN npm install
COPY web/ ./
RUN npm run build

# Stage 2: Go
FROM docker.io/library/golang:1.24-bookworm AS go-builder
WORKDIR /app
ARG BUILD_VERSION=dev
ENV GOPROXY=https://proxy.golang.org GOTOOLCHAIN=local
COPY go.mod go.sum ./
RUN go mod download
COPY cmd/ ./cmd/
COPY internal/ ./internal/
COPY --from=web-builder /app/web/dist ./cmd/dasm-burner/static
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 \
    go build -ldflags "-s -w -X main.version=${BUILD_VERSION}" \
    -o /dasm-burner ./cmd/dasm-burner

# Stage 3: runtime
FROM registry.access.redhat.com/ubi9/ubi-minimal:latest
COPY --from=go-builder /dasm-burner /usr/local/bin/dasm-burner
USER 65532
ENV LISTEN_ADDR=:8080
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/dasm-burner"]
CMD ["serve", "--addr", ":8080", "--run-dir", "/tmp"]
